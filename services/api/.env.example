# Local development defaults. Copy to .env and replace values as needed.
# Never commit .env or put backend secrets in NEXT_PUBLIC_* variables.
APP_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000

# Connect a development Neon/PostgreSQL database to use persisted app features.
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_URL_UNPOOLED=

# Local secrets are for development only; use unique cryptographic values.
SESSION_HASH_KEY=
OTP_HMAC_KEYS=
INTERNAL_API_KEYS=

# OAuth and email are optional during local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Local storage is convenient for development; objects stay under STORAGE_LOCAL_DIR.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/v1/media/content
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Optional Neon Auth and Realtime integrations.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

DB_MAX_CONNS=5
DB_MIN_CONNS=1
REQUEST_TIMEOUT_SECONDS=15
