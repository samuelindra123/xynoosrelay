# XYNOSS Relay — Environment Variables Reference

# Environment: development | staging | production | test
APP_ENV=development

# Server Port
PORT=8080

# Public API Base URL
API_BASE_URL=http://localhost:8080

# Frontend URL (for OAuth callbacks and redirects)
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins (comma-separated, explicit origins only; no wildcards with credentials)
WEB_ORIGINS=http://localhost:3000,https://app.xynoss.relay

# Neon PostgreSQL connection string (pooled endpoint for runtime Chi server)
DATABASE_URL=postgres://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL direct connection string (unpooled endpoint for goose migrations)
DATABASE_DIRECT_URL=postgres://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session and authentication secrets (minimum 32 cryptographically secure characters)
SESSION_HASH_KEY=development-session-hash-key-at-least-32-chars
OTP_HMAC_KEYS=v1:development-otp-hmac-key-at-least-32-chars

# Google OAuth / OpenID Connect credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback

# Internal service-to-service communication keys (comma-separated for key rotation support)
INTERNAL_API_KEYS=your-cryptographically-secure-internal-api-key-v1

# Object Storage Provider (local | s3 | r2 | neon)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/v1/media/content

# Cloudflare R2 / AWS S3 / Neon Object Storage configuration (used if STORAGE_PROVIDER is s3/r2/neon)
STORAGE_BUCKET=xynoss-relay-media
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key

# Neon Managed Services
NEON_AUTH_BASE_URL=https://ep-sample.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-sample.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://ep-sample.rt.c-9.us-east-2.aws.neon.tech/
NEON_REALTIME_SECRET=your-neon-realtime-secret

# Connection pool tuning (recommended 2-5 for serverless Neon architectures)
DB_MAX_CONNS=5
DB_MIN_CONNS=1

# Request execution timeout in seconds
REQUEST_TIMEOUT_SECONDS=15

# Email OTP dan Google OAuth
RESEND_API_KEY=
RESEND_FROM_EMAIL=
