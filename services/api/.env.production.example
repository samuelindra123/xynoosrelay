# Production deployment template only. Set real values in the API host's secret manager.
# Do not commit a populated production .env file.
APP_ENV=production
PORT=8080
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://your-app.vercel.app
WEB_ORIGINS=https://your-app.vercel.app

# Use a pooled URL at runtime and a direct/unpooled URL for database migrations.
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_URL_UNPOOLED=

# Generate unique values per environment. OTP key format: version:secret.
SESSION_HASH_KEY=
OTP_HMAC_KEYS=
INTERNAL_API_KEYS=

# OAuth callback must exactly match the provider console and API_BASE_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/v1/auth/google/callback

# Neon private object storage credentials; use a dedicated production bucket/branch.
STORAGE_PROVIDER=neon
STORAGE_BUCKET=uploads
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Configure one transactional email provider and a verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Neon integrations.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

DB_MAX_CONNS=5
DB_MIN_CONNS=1
REQUEST_TIMEOUT_SECONDS=15
